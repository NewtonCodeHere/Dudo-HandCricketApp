{
  "expo": {
    "name": "DUDO Hand Cricket",
    "slug": "dudo-handcricket-app",
    "owner": "newtoncodes-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.dudo.handcricketapp",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#FF5A5F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": []
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "7748c16d-6ede-465f-ae2a-318b5ef6b720"
      }
    },
    "plugins": [
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": false,
            "enableShrinkResourcesInReleaseBuilds": false,
            "extraProguardRules": "-dontwarn expo.modules.av.**\n-dontwarn expo.modules.core.**\n-dontwarn expo.modules.kotlin.**\n-keep class expo.modules.** { *; }\n-keep class com.swmansion.gesturehandler.** { *; }\n-keep class com.swmansion.reanimated.** { *; }"
          }
        }
      ],
      "expo-audio"
    ]
  }
}
